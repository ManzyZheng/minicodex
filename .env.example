# Copy this file to .env and replace the placeholder with your DashScope API Key.
DASHSCOPE_API_KEY=sk-xxx
MINICODEX_MODEL=qwen3.8-flash
# Optional comma-separated model allowlist for the Web Composer.
MINICODEX_MODELS=qwen3.8-flash

# Optional application-owned storage root for projects, sessions, traces, and memories.
# Defaults to %LOCALAPPDATA%/MiniCodex on Windows.
# MINICODEX_DATA_DIR=D:\MiniCodexData
MINICODEX_BASE_URL=https://ws-2r6gaasmu4dyhxq0.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Optional. Keep ordinary coding tasks fast; enable only when deeper reasoning is useful.
MINICODEX_ENABLE_THINKING=false
# AUTO-ACT gray-zone approval. The reviewer uses a separate, non-thinking request.
MINICODEX_REVIEWER_ENABLED=true
# Optional; defaults to MINICODEX_MODEL.
MINICODEX_REVIEWER_MODEL=qwen3.8-flash
